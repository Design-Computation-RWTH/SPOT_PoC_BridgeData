:002 a spot:DocumentSpace ;
    rdfs:label "002 Document Space" ;
    dcterms:format "pdf" ;
    dcterms:type "application/pdf" ;
    rdfs:comment "arstellung: Bestandsübersicht Strombrücke Schnitte, Details Statik und Konstruktion" ;
    dcat:accessURL "Plans\\002.png" ;
    spot:hasSubspace :Detail_1__o__M_,
