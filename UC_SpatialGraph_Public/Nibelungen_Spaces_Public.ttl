:002_Axis_X a spot:Axis ;
    rdfs:label "002 X Axis" ;
    spot:hasDirection spot:Right .

:002_Axis_Y a spot:Axis ;
    rdfs:label "002 Y Axis" ;
    spot:hasDirection spot:Bottom .


