#  CQ 2 (by reloc props): What other resources provide information about the same location of the asset as the view "AUSSPARUNGEN Area Space"?

PREFIX : <http://example.org/>
PREFIX spot: <https://w3id.org/spot#>
PREFIX reloc: <https://w3id.org/reloc#>
PREFIX spot-am: <https://w3id.org/spot/am#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>

SELECT DISTINCT  ?otherEntitySpace (GROUP_CONCAT(DISTINCT (?relationLabel); separator=", ") AS ?dirProps) ?refSpace ?path
WHERE {
  # define variable input via label
  # get appearance/location of variable space in asset
  ?var rdfs:label "AUSSPARUNGEN Area Space";
       spot:hasAppearance  ?appVar .
  ?appVar spot:appearsIn   ?assetSpace ;
          spot-am:hasBoundaryPointMapping ?bpmVar .
  ?assetSpace a spot:AssetSpace .
  ?bpmVar ?directionalProperty ?refSpace .
  ?directionalProperty rdfs:subPropertyOf*  reloc:directionalRelation.

  # get other entity spaces and their asset or entity appearances (bpms)
  ?otherEntitySpace a/rdfs:subClassOf* spot:EntitySpace ;
                    spot:hasAppearance ?appOther ;
    				dcat:accessURL ?path .
  ?appOther a ?appCls;
            spot-am:hasBoundaryPointMapping ?bpmOther .
  FILTER(?appCls IN(spot:AssetAppearance, spot:EntityAppearance))
  #filter for other entity spaces with same relation to same reference space
  ?bpmOther ?directionalProperty ?refSpaceOther.

  # refSpaceOther is same as refSpace, or space with same boundaries
   FILTER ( IF(?refSpace IN (?assetSpace),
           ?refSpaceOther IN (?refSpace, ?assetSpace),
                ?refSpaceOther = ?refSpace ) )

  FILTER(?otherEntitySpace != ?var)
  ?directionalProperty rdfs:label ?relationLabel.
  FILTER langMatches(lang(?relationLabel), "en")
}
GROUP BY ?var ?otherEntitySpace ?refSpace ?path
# order results by number of same/similar relations
ORDER BY DESC (COUNT(DISTINCT ?relationLabel))