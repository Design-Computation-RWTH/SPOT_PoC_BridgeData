# CQ4: Where was \textit{this picture} taken?
PREFIX : <http://example.org/>
PREFIX spot: <https://w3id.org/spot#>
PREFIX reloc: <https://w3id.org/reloc#>
PREFIX spot-am: <https://w3id.org/spot/am#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?x
       (GROUP_CONCAT(DISTINCT ?relationLabel; separator=", ") AS ?dirProps)
       ?refSpace ?path
WHERE {
  # Filter for Image, instead of one input picture
  ?x a spot:PointSpace ;
     dcterms:type "image";
     dcat:accessURL ?path ;
     spot:hasAppearance ?appPic .
      {
      ?appPic spot:appearsIn ?refSpace ;
              spot-am:hasBoundaryPointMapping ?bpmPic .
      ?bpmPic ?directionalProperty ?refSpace .
      ?directionalProperty rdfs:subPropertyOf* reloc:directionalRelation;
                           rdfs:label ?relationLabel.
      FILTER langMatches(lang(?relationLabel), "en")
      }
}
GROUP BY ?x ?refSpace ?assetSpaceRef ?path
ORDER BY ?x