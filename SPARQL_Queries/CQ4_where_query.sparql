# CQ4: Where was \textit{this Image} taken and in which direction does it view?
PREFIX : <http://example.org/>
PREFIX spot: <https://w3id.org/spot#>
PREFIX reloc: <https://w3id.org/reloc#>
PREFIX spot-am: <https://w3id.org/spot/am#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?img
       (GROUP_CONCAT(DISTINCT ?relationLabel; separator=", ") AS ?cameraLocation) ?viewingDirection ?viewingDirectionAccuracy
       ?refSpace ?path
WHERE {
  ?img a spot:PointSpace ;
     dcterms:type "image";
     dcat:accessURL ?path ;
     # zaxis indicating viewing direction
     spot:hasZAxis ?imgZAxis;
     spot:hasAppearance ?appImg .

     ?appImg spot:appearsIn ?refSpace ;
          spot-am:hasBoundaryPointMapping ?bpmImg ;
          spot-am:hasAxisMapping ?amImg.
    ?bpmImg ?directionalProperty ?refSpace .
    ?directionalProperty rdfs:subPropertyOf* reloc:directionalRelation;
                       rdfs:label ?relationLabel.
     FILTER langMatches(lang(?relationLabel), "en")

    ?amImg spot-am:hasSourceAxis ?imgZAxis;
           spot-am:hasTargetAxis ?refSpaceAxis;
           spot-am:hasAxisRelationType ?relType;
            spot-am:hasAccuracy ?viewingDirectionAccuracy.
    ?refSpaceAxis spot:hasDirection ?refSpaceAxisDir.
    ?refSpaceAxisDir spot:isInverseDirectionOf ?refSpaceAxisInvDir.
    BIND(
      IF(?relType = spot-am:Antiparallel, ?refSpaceAxisInvDir, ?refSpaceAxisDir) AS ?viewingDirection
    )
}
GROUP BY ?img ?viewingDirection ?viewingDirectionAccuracy ?refSpace ?path
ORDER BY ?img
