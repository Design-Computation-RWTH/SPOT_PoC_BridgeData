#  CQ 3: What other resources provide spatially complementary information to Querschnitt im Scheitelbereich, M. 1:50'?

PREFIX : <http://example.org/>
PREFIX spot: <https://w3id.org/spot#>
PREFIX reloc: <https://w3id.org/reloc#>
PREFIX spot-am: <https://w3id.org/spot/am#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>

SELECT DISTINCT  ?otherEntitySpace  (GROUP_CONCAT(DISTINCT (?relationLabel); separator=", ") AS ?dirProps) ?refSpace ?path
WHERE {
  # define variable input via label
  # get appearance/location of variable space in asset
  ?var rdfs:label "Querschnitt im Scheitelbereich, M_ 1_50 Vertical Area Space";
       spot:hasAppearance ?appVar;
       spot:hasZAxis ?varZ.
  ?appVar a spot:AssetAppearance;
          spot-am:hasBoundaryPointMapping ?bpmVar ;
          spot-am:hasAxisMapping ?amVar.
  ?bpmVar ?directionalProperty ?refSpace .
  ?directionalProperty rdfs:subPropertyOf*  reloc:directionalRelation.
  # get orientation to asset
  ?amVar spot-am:hasSourceAxis ?varZ;
         spot-am:hasTargetAxis ?assetAxis_am_VarZ.
  # get other entity spaces and their asset appearances (bpms)
  ?otherEntitySpace a/rdfs:subClassOf* spot:EntitySpace ;
                    spot:hasAppearance ?appOther ;
                    spot:hasZAxis ?otherZ;
    				dcat:accessURL ?path .
  ?appOther a spot:AssetAppearance;
            spot-am:hasBoundaryPointMapping ?bpmOther ;
            spot-am:hasAxisMapping ?amOther.
  #filter for other entity spaces with same relation to same reference space
  ?bpmOther ?directionalProperty ?refSpaceOther.
  FILTER ( ?refSpaceOther = ?refSpace )
  #filter other entity spaces with complimentary orientations
  ?amOther spot-am:hasSourceAxis ?otherZ;
         spot-am:hasTargetAxis ?assetAxis_am_OtherZ.
  FILTER(?assetAxis_am_OtherZ != ?assetAxis_am_VarZ)

  FILTER(?otherEntitySpace != ?var)
  ?directionalProperty rdfs:label ?relationLabel.
  FILTER langMatches(lang(?relationLabel), "en")
}
GROUP BY ?var ?otherEntitySpace ?assetAxis_am_VarZ ?assetAxis_am_OtherZ ?refSpace ?path
# order results by number of same/similar relations
ORDER BY DESC (COUNT(DISTINCT ?relationLabel))


